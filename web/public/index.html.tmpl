<!DOCTYPE html>
{{- /*
  index.html.tmpl — public profile, server-rendered.

  Receives the full Config struct from internal/server/handlers.go.
  No JavaScript on this page by design. Theme is fixed to light;
  the admin tool toggles its own theme independently.

  Template helpers (registered in handlers.go):
    iconSVG <name>     -> template.HTML, returns an inline <svg>
                          for the given icon name from the bundled set.

  Animation entry timings live in styles.css (.link:nth-child(n)).
  No nth-child stagger is applied to social pills — they fade in
  together as one row.
*/ -}}
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{.Meta.Title}}</title>
{{- if .Meta.Description}}
<meta name="description" content="{{.Meta.Description}}" />
{{- end}}
<link rel="icon" href="{{if .Meta.Favicon}}{{.Meta.Favicon}}{{else}}/static/favicon.svg{{end}}" />
<link rel="stylesheet" href="/static/styles.css" />
{{- /* Web fonts are a third-party request: fetching them hands the
       visitor's IP and User-Agent to Google. The handler decides
       whether that's allowed (operator setting + this visitor's
       opt-out state) and we render nothing when it isn't — the CSS
       stacks in styles.css already name local fallbacks. */ -}}
{{- if .UseWebFonts}}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="{{.FontsURL}}" />
{{- end}}
<style>
:root {
  --avatar-size: {{.Profile.AvatarSize}}px;
  --avatar-shape: {{.Profile.AvatarShape}}%;
  --font-display: "{{.Theme.FontDisplay}}", Georgia, serif;
  --font-body: "{{.Theme.FontBody}}", -apple-system, sans-serif;
  --font-mono: "{{.Theme.FontMono}}", ui-monospace, monospace;
  --banner-bg: {{.Banner.Background}};
  --banner-fg: {{.Banner.TextColor}};
  --banner-duration: {{.BannerDurationSec}}s;
}
</style>
<style>:root { --avatar-size: {{.Profile.AvatarSize}}px; --avatar-shape: {{.Profile.AvatarShape}}%; }</style>
{{- /* Open Graph / Twitter — minimal, no images. Avatar isn't a
       reliable OG card image (1:1 instead of 1.91:1) so we omit. */ -}}
<meta property="og:title" content="{{.Meta.Title}}" />
{{- if .Meta.Description}}
<meta property="og:description" content="{{.Meta.Description}}" />
{{- end}}
<meta property="og:type" content="website" />
{{- /* Operator-supplied <head> HTML. The handler blanks this for a
       visitor who has opted out (via Sec-GPC, DNT, or the site's own
       control) whenever it's classified as analytics or advertising,
       so test the rendered value, not the raw config field. */ -}}
{{- if .RawHeadSnippet}}
{{.RawHeadSnippet}}
{{- end}}
</head>
<body>
{{- if .Banner.Enabled}}
<div class="banner{{if .Banner.Scroll}} banner-is-scrolling{{end}}" role="status" aria-live="polite">
  {{- if .Banner.Scroll}}
  <div class="banner-track">
    <span class="banner-text">{{.Banner.Text}}</span>
    <span class="banner-text" aria-hidden="true">{{.Banner.Text}}</span>
  </div>
  {{- else}}
  <span class="banner-text">{{.Banner.Text}}</span>
  {{- end}}
</div>
{{- end}}
<main class="page">
  <header class="profile">
    <div class="avatar-wrap">
      {{- /* Avatar URL: served by the avatar handler at /avatar.
             Falls back to bundled default if the field is empty. */ -}}
      <img class="avatar"
           src="{{if .Profile.Avatar}}{{.Profile.Avatar}}{{else}}/static/assets/avatar.svg{{end}}"
           alt="{{if .Profile.Name}}{{.Profile.Name}} avatar{{else}}avatar{{end}}" />
    </div>
    <h1 class="name">{{if .Profile.Name}}{{.Profile.Name}}{{else}}&nbsp;{{end}}</h1>
    {{- if .Profile.Tagline}}
    <p class="tagline">{{.Profile.Tagline}}</p>
    {{- end}}
    {{- if .Profile.Bio}}
    <p class="bio">{{.Profile.Bio}}</p>
    {{- end}}
    {{- if .Profile.Location}}
    <p class="location">{{.Profile.Location}}</p>
    {{- end}}
  </header>

  <hr class="rule" aria-hidden="true" />

  {{- if .Links}}
  <section class="links" aria-label="Primary links">
    {{- range .Links}}
    <a class="link{{if .Featured}} is-featured{{end}}"
       href="{{.URL}}"
       target="_blank"
       rel="noopener noreferrer">
      <span class="link-icon">{{iconSVG .Icon}}</span>
      <span class="link-body">
        <span class="link-label">{{.Label}}</span>
        {{- if .Description}}
        <span class="link-desc">{{.Description}}</span>
        {{- end}}
      </span>
      <span class="link-arrow">{{iconSVG "arrow"}}</span>
    </a>
    {{- end}}
  </section>
  {{- end}}

  {{- if .Social}}
  <nav class="social" aria-label="Social profiles">
    {{- range .Social}}
    <a class="social-link"
       href="{{.URL}}"
       target="_blank"
       rel="noopener noreferrer"
       aria-label="{{.Platform}}">
      {{iconSVG .Platform}}
    </a>
    {{- end}}
  </nav>
  {{- end}}

  {{- /* Footer composes "© YEAR" + custom text, joined by ·.
         Year is rendered server-side from .Now (passed by handler). */ -}}
  {{- $showYear := .Footer.ShowYear}}
  {{- $text := .Footer.Text}}
  {{- /* The footer always renders now: even with no copyright line and
         no custom text it carries the privacy notice link, which has to
         be reachable from the page that does the collecting. */ -}}
  <footer class="footer">
    {{- if or $showYear $text}}
    <p class="footer-line">
      {{- if $showYear}}&copy; {{.Year}}{{end}}
      {{- if and $showYear $text}} &middot; {{end}}
      {{- if $text}}{{$text}}{{end}}
    </p>
    {{- end}}
    <p class="footer-privacy">
      <a class="privacy-link" href="/privacy">
        {{- if .ShowOptOutIcon}}
        <span class="privacy-link-icon" aria-hidden="true">{{iconSVG "privacy-choices"}}</span>
        {{- end}}
        <span>{{.PrivacyLinkLabel}}</span>
      </a>
    </p>
  </footer>
</main>
</body>
</html>
